  {
   "fieldname": "magic_link_base_url",
   "fieldtype": "Data",
   "label": "Magic Link Base URL",
   "reqd": 1,
   "description": "The base URL mint_magic_link (tap_app/api/auth.py) prepends to a minted token to build the full, shareable magic_link_url -- e.g. the app's deep-link domain or a web redirect endpoint that itself hands the token to the TapApp Worker's /auth/redeem. Stored here, not hardcoded, because this value differs by environment (staging vs. production) and can change independently of a Frappe deploy. The token is appended as-is, with no added query parameters or path segments, so this value should already end in whatever separator the receiving endpoint expects (a trailing '/', or a '?token=' style prefix, depending on how that endpoint is built)."
  },
